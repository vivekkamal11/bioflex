# BioFlex Tech Agency - Environment Variables
# In sab ko Vercel Project Settings -> Environment Variables me set karo (kabhi commit mat karna)

# Razorpay keys (Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_XXXX
RAZORPAY_KEY_SECRET=your_key_secret

# Webhook secret (Razorpay Dashboard -> Settings -> Webhooks -> create webhook)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Telegram notification (recommended - @BotFather se token banao, @userinfobot se chat id)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# CallMeBot WhatsApp API (optional - CallMeBot abhi full hai, apikey nahi mil rahi)
CALLMEBOT_APIKEY=your_callmebot_apikey

# Owner ka WhatsApp number jispar payment notifications jayengi (country code ke saath, no +)
WA_TO_NUMBER=919235290796
